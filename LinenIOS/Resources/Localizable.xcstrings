      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الكاميرا إلى الرمز"
          }
        }
      }
    },
    "Point at the code in Linen's Settings on your Mac, under iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الكاميرا إلى الرمز في إعدادات سطر على جهاز الماك، تحت الآيفون."
          }
        }
      }
    },
