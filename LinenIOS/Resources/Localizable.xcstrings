      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظة"
          }
        }
      }
    },
    "Nothing by that name": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بهذا الاسم"
          }
        }
      }
    },
    "Nothing is kept on this iPhone yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء محفوظ على هذا الآيفون بعد"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسنًا"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغلقة"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّل"
          }
        }
      }
    },
    "On this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الآيفون"
          }
        }
      }
    },
    "On your Mac, choose File › Keep on iPhone for a folder. It arrives here when the Mac is near.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز الماك، اختر ملف › احفظ على الآيفون لمجلد. يصل إلى هنا حين يكون الماك قريبًا."
          }
        }
      }
    },
    "On your Mac, open Settings, iPhone, Pair for a new code, then point at it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز الماك، افتح الإعدادات، الآيفون، إقران لرمز جديد، ثم وجّه الكاميرا إليه مجددًا."
          }
        }
      }
    },
    "On, for pairing only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّلة، للإقران فقط"
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح"
          }
        }
      }
    },
    "Open this address?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتفتح هذا العنوان؟"
          }
        }
      }
    },
    "Opened on this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُتح على هذا الآيفون"
          }
        }
      }
    },
    "Outline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المخطط"
          }
        }
      }
    },
    "Page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة"
          }
        }
      }
    },
    "Pages cannot use the camera or microphone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع الصفحات استخدام الكاميرا أو الميكروفون"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقران"
          }
        }
      }
    },
    "Pair again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرن من جديد"
          }
        }
      }
    },
    "Pair with %@?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإقران مع %@؟"
          }
        }
      }
    },
    "Pair with a Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إقران بجهاز ماك"
          }
        }
      }
    },
    "Pair with your Mac, then choose File › Keep on iPhone there for a folder. Files you open from Files or AirDrop also appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرن الآيفون بجهاز الماك، ثم اختر هناك ملف › احفظ على الآيفون لمجلد. وتظهر هنا أيضًا الملفات التي تفتحها من تطبيق الملفات أو AirDrop."
          }
        }
      }
    },
    "Paired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاقتران"
          }
        }
      }
    },
    "Paired with %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترن بـ %@"
          }
        }
