    },
    "The Mac did not answer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُجب الماك"
          }
        }
      }
    },
    "The Mac is pairing another phone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الماك يقترن بهاتف آخر"
          }
        }
      }
    },
    "The Mac refused this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الماك هذا الآيفون"
          }
        }
      }
    },
    "The code did not match": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتطابق الرمز"
          }
        }
      }
    },
    "This Mac no longer knows this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الماك يعرف هذا الآيفون"
          }
        }
      }
    },
    "This copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة"
          }
        }
      }
    },
    "This copy of Linen stops opening in %lld days": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف هذه النسخة من سطر عن الفتح بعد %lld أيام"
          }
        }
      }
    },
    "This file is no longer on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا الملف على هذا الآيفون."
          }
        }
      }
    },
    "This page draws with scripts, and scripts are off on this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترسم هذه الصفحة ببرامج نصية، والبرامج النصية مغلقة على هذا الآيفون"
          }
        }
      }
    },
    "This page stopped Linen's view again; showing its source": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفت هذه الصفحة عرض سطر مرة أخرى؛ يُعرض مصدرها"
          }
        }
      }
    },
    "This replaces %@. Everything kept on this iPhone from it is removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يحل محل %@. يُحذف كل ما حُفظ منه على هذا الآيفون."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مجددًا"
          }
        }
      }
    },
    "Turn it on in Settings › Linen › Local Network, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّله من الإعدادات › سطر › الشبكة المحلية، ثم حاول مجددًا."
          }
        }
      }
    },
    "Up to date with %@ · %@": {
      "localizations": {
        "ar": {
