    "Text size": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم النص"
          }
        }
      }
    },
    "That code has expired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية هذا الرمز"
          }
        }
      }
    },
    "That is not a Linen pairing code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رمز إقران سطر"
          }
        }
