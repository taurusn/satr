{
  "sourceLanguage": "en",
  "strings": {
    "%@ is asleep": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نائم"
          }
        }
      }
    },
    "%@ is asleep · copies from %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ نائم · نسخ من %2$@"
          }
        }
      }
    },
    "%@ · Not on this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ليس على هذا الآيفون"
          }
        }
      }
    },
    "%@, named “%@”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@، باسم «%2$@»"
          }
        }
      }
    },
    "%lld changed since you read it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld تغيير منذ قرأته"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld من %2$lld"
          }
        }
      }
    },
    "Asked when you pair": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب عند الإقران"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رجوع"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا"
          }
        }
      }
    },
    "Camera access is off for Linen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول سطر إلى الكاميرا مغلق"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "Canvas": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللوحة"
          }
        }
      }
    },
    "Changed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر"
          }
        }
      }
    },
    "Changed since you read it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر منذ قرأته"
          }
        }
      }
    },
    "Changes are not marked in pages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُعلَّم التغييرات في الصفحات"
          }
        }
      }
    },
    "Check that your Mac shows the same six digits, then click Allow there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن جهاز الماك يعرض الأرقام الستة نفسها، ثم انقر «السماح» هناك."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم"
          }
        }
      }
    },
    "Everything kept on this iPhone from it is removed. Pair again to bring it back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف كل ما حُفظ منه على هذا الآيفون. أقرنه من جديد لاستعادته."
          }
        }
      }
    },
    "Find": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحث"
          }
        }
      }
    },
    "Finding your Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن جهاز الماك"
          }
        }
      }
    },
    "Finishing %lld files paused when you left": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكمل %lld ملفات توقفت حين غادرت"
          }
        }
      }
    },
    "Folders you keep on iPhone from your Mac arrive in the Library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل إلى المكتبة المجلدات التي تحفظها على الآيفون من جهاز الماك."
          }
        }
      }
    },
    "Forget this Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسَ هذا الماك"
          }
        }
      }
    },
    "Forget this Mac?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتنسى هذا الماك؟"
          }
        }
      }
    },
    "If that was a mistake, pair again and click Allow on the Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كان ذلك خطأً، أقرن من جديد وانقر «السماح» على الماك."
          }
        }
      }
    },
    "In Linen on your Mac: Settings, iPhone, Pair. Linen will ask to find devices on your local network; that is how it reaches the Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في سطر على جهاز الماك: الإعدادات، الآيفون، إقران. سيطلب سطر إذنًا للعثور على الأجهزة في شبكتك المحلية؛ بهذا يصل إلى الماك."
          }
        }
      }
    },
    "Installed from Xcode": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبّت من Xcode"
          }
        }
      }
    },
    "JSON Canvas": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON Canvas"
          }
        }
      }
    },
    "Keep the iPhone on the same Wi-Fi as the Mac, with the Mac awake, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الآيفون على شبكة Wi-Fi نفسها التي عليها الماك، والماك مستيقظ، ثم حاول مجددًا."
          }
        }
      }
    },
    "Kept here": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحفوظ هنا"
          }
        }
      }
    },
    "Larger text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص أكبر"
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكتبة"
          }
        }
      }
    },
    "Linen could not reach that Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على سطر الوصول إلى ذلك الماك"
          }
        }
      }
    },
    "Linen could not seal this page, so it shows its source": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على سطر عزل هذه الصفحة، فيعرض مصدرها"
          }
        }
      }
    },
    "Linen does not open %@ from a page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يفتح سطر %@ من صفحة"
          }
        }
      }
    },
    "Linen does not open %@: links": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يفتح سطر روابط %@:"
          }
        }
      }
    },
    "Linen on this iPhone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطر على هذا الآيفون"
          }
        }
      }
    },
    "Linen opens notes, boards and pages (.md, .txt, .canvas, .html); %@ is not one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح سطر الملاحظات واللوحات والصفحات (.md و.txt و.canvas و.html)، و%@ ليس منها."
          }
        }
      }
    },
    "Linen opens notes, boards and pages only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح سطر الملاحظات واللوحات والصفحات فقط"
          }
        }
      }
    },
    "Linen uses the camera only to read the pairing code on your Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم سطر الكاميرا لقراءة رمز الإقران على جهاز الماك فقط."
          }
        }
      }
    },
    "Linen will connect to %@ and show six digits to check on that Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتصل سطر بـ %@ ويعرض ستة أرقام لتتحقق منها على ذلك الماك."
          }
        }
      }
    },
