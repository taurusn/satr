    "NSCameraUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم سطر الكاميرا لقراءة رمز الإقران على جهاز الماك فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linen uses the camera only to read the pairing code on your Mac."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد سطر جهاز الماك على الشبكة المحلية ليجلب المجلدات التي تحفظها على هذا الآيفون."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linen finds your Mac on the local network to bring over the folders you keep on this iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
