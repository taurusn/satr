.DS_Store
build/
node_modules/
*.xcodeproj/
DerivedData/
# Thmanyah fonts are copied from ~/Library/Fonts at build time and never committed (license).
thmanyah*.otf
docs/spikes/*/corpus
docs/spikes/*/watch
