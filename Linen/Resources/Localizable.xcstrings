{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "%@ is not Linen's command, so Linen left it alone. Move it away and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ ليس أمر سطر، فتركه سطر كما هو. انقله إلى مكان آخر ثم حاول مجددًا."
          }
        }
      }
    },
    "%lld notes called %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ملاحظات باسم %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld notes called %2$@"
          }
        }
      }
    },
    "%lld × %lld px is past the PNG limit even at 1x; export one section per file" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld × %lld بكسل أكبر من حد PNG حتى بمقياس 1x؛ صدّر كل قسم في ملف"
