{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    " in %lld subfolders" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " في %lld مجلدات فرعية"
          }
        }
      }
    },
    "%@ is not Linen's command, so Linen left it alone. Move it away and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ ليس أمر سطر، فتركه سطر كما هو. انقله إلى مكان آخر ثم حاول مجددًا."
          }
        }
      }
    },
    "%@ · connected now" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · متصل الآن"
          }
        }
      }
    },
    "%@ · last seen %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · آخر ظهور %2$@"
          }
        }
      }
    },
    "%@ · not seen since pairing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · لم يظهر منذ الإقران"
