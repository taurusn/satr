        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld notes called %2$@"
          }
        }
      }
    },
    "%lld × %lld px is past the PNG limit even at 1x; export one section per file" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld × %lld بكسل أكبر من حد PNG حتى بمقياس 1x؛ صدّر كل قسم في ملف"
          }
        }
      }
    },
    "%lld × %lld px is past the PNG limit; %lldx fits" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld × %lld بكسل أكبر من حد PNG؛ يناسبه %lldx"
