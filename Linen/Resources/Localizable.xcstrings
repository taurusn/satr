    },
    "+" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+"
          }
        }
      }
    },
    "A small helper inside Linen keeps the folders you pin ready for your iPhone, even when Linen is closed. It starts at login and has no Dock icon. macOS will ask whether Linen may find devices on your local network: allow it, since that is how your iPhone reaches this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي مساعد صغير داخل سطر المجلدات التي تثبّتها جاهزة لآيفونك، حتى حين يكون سطر مغلقًا. يبدأ عند تسجيل الدخول ولا أيقونة له في Dock. سيسأل macOS هل يُسمح لسطر بالعثور على الأجهزة في شبكتك المحلية: اسمح بذلك، فبهذا يصل آيفونك إلى هذا الماك."
          }
        }
      }
    },
    "About Linen" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حول سطر"
          }
        }
      }
    },
    "Actual Size" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحجم الفعلي"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
