          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على سطر قراءة هذه الملاحظة لتصديرها HTML: ‏%@"
          }
        }
      }
    },
    "Linen could not write %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على سطر كتابة %@"
          }
        }
      }
    },
    "Linen is not set up for your iPhone yet." : {
      "localizations" : {
